{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git stash list:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(pwd)",
      "Bash(pnpm test:*)",
      "Bash(pnpm check:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm index:legacy:*)",
      "Bash(pnpm strict:audit)",
      "Bash(pnpm strict:check)",
      "Bash(pnpm audit:coverage)",
      "Bash(pnpm --version)",
      "Bash(node --version)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/regen-legacy-index.sh",
            "timeout": 120,
            "statusMessage": "Regenerating legacy indexes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/typecheck-on-stop.sh",
            "timeout": 600,
            "statusMessage": "pnpm check on edited TypeScript"
          }
        ]
      }
    ]
  }
}
