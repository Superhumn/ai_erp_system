# Server Configuration
NODE_ENV=development
PORT=3000

# Code module — server-side execution (admin-only /code IDE)
# The "Run" button executes arbitrary code on the app server's host. There is
# no true sandbox in this stack, so it is OFF by default unless you opt in.
#   unset            → enabled ONLY when NODE_ENV=development or =test;
#                      disabled everywhere else (staging, production, unset)
#   CODE_EXEC_ENABLED=true   → force enable   (accept host-level RCE risk)
#   CODE_EXEC_ENABLED=false  → force disable everywhere
# CODE_EXEC_ENABLED=false
# Network isolation for executed code via util-linux `unshare` (blocks network
# egress from runs). Requires `unshare` on the host plus permission to create an
# unprivileged `--net --map-root-user` namespace. If enabled but the host can't
# provide it, runs FAIL CLOSED (are refused) rather than running with network
# access.
# CODE_EXEC_NETWORK_ISOLATION=true

# Application URLs
APP_URL=http://localhost:3000
VITE_APP_URL=http://localhost:3000
PUBLIC_APP_URL=https://aierpsystem-production.up.railway.app

# Application Branding (Optional)
VITE_APP_ID=ai_erp_system
VITE_APP_TITLE=AI ERP System
VITE_APP_LOGO=

# Database (MySQL 8+)
# For local:        mysql://user:password@localhost:3306/ai_erp_system
# For Docker:       mysql://erp_user:erp_password@db:3306/ai_erp_system
# For PlanetScale:  mysql://username:password@host.aws.connect.psdb.cloud/database?ssl={"rejectUnauthorized":true}
#   → Copy the exact URL from PlanetScale dashboard → Connect → Node.js / @planetscale/database
DATABASE_URL=mysql://user:password@localhost:3306/ai_erp_system

# Authentication
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=your-secret-key-here-min-32-chars-change-this
OWNER_OPEN_ID=

# ============================================
# LLM / AI Configuration (Anthropic Claude)
# ============================================
# Get your API key at: https://console.anthropic.com/settings/keys
# The system uses Claude for AI Assistant, AI Command Bar,
# autonomous workflows, document parsing, email categorization,
# and forecasting features.
#
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=claude-sonnet-4-20250514

# Google OAuth & API (for Google Sheets/Drive integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_SHEETS_API_KEY=
GOOGLE_CHAT_OPS_WEBHOOK=

# Google Service Account (optional — lets the server read private Drive folders
# shared with the service account, without making files public or relying on a
# user's OAuth grant). Create one in Google Cloud Console → IAM → Service
# Accounts, download the JSON key, then share the private Drive folder with the
# service account's email address.
#
# Option A (recommended): paste the full JSON key as a single-line string:
GOOGLE_SERVICE_ACCOUNT_JSON=
# Option B: provide email + key separately. Escape newlines in the private key
# as \n (e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n").
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Email Configuration (IMAP - for inbox scanning)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# SendGrid Email Service (for transactional emails)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_REPLY_TO=
SENDGRID_WEBHOOK_SECRET=

# QuickBooks OAuth & API
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=
QUICKBOOKS_ENVIRONMENT=production

# Mercury Banking API (optional)
# When set, enables real-time account balances and a 24h transaction sync.
# Get a token from: https://app.mercury.com/settings/tokens
# Without this, the Banking module returns empty balances and the
# `banking.syncTransactions` mutation rejects with PRECONDITION_FAILED.
MERCURY_API_TOKEN=

# EDI Webhook Authentication
# Required in production. Generate with: openssl rand -hex 32
EDI_WEBHOOK_SECRET=

# Shopify OAuth & API
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=

# OAuth Server (for federated/SSO authentication)
OAUTH_SERVER_URL=

# Twilio (voice/SMS integration)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# WhatsApp Business sender for live WhatsApp send/receive (see docs/WHATSAPP_SETUP.md).
# Format: whatsapp:+14155238886 (or a bare +14155238886).
TWILIO_WHATSAPP_NUMBER=

# Airtable Integration
AIRTABLE_PERSONAL_ACCESS_TOKEN=

# API Proxy (image generation / voice / maps / data API)
API_PROXY_URL=
API_PROXY_KEY=

# OpenAI-compatible API (fallback LLM provider)
OPENAI_API_BASE_URL=
OPENAI_API_KEY=

# Cloudflare R2 (S3-compatible; primary file storage)
# Get your Account ID from the Cloudflare dashboard → R2 → Overview.
# Create an API token under Manage R2 API Tokens with Object Read & Write permissions.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: set to your bucket's public URL or custom domain to serve files directly.
# Example: https://pub-xxxx.r2.dev  or  https://assets.yourdomain.com
R2_PUBLIC_URL=

# Error Tracking (optional — install @sentry/node to enable)
SENTRY_DSN=
