# Server Configuration
NODE_ENV=development
PORT=3000

# Application URLs
APP_URL=http://localhost:3000
VITE_APP_URL=http://localhost:3000
PUBLIC_APP_URL=https://aierpsystem-production.up.railway.app

# Application Branding (Optional)
VITE_APP_ID=ai_erp_system
VITE_APP_TITLE=AI ERP System
VITE_APP_LOGO=

# Database (MySQL 8+)
# For local: mysql://user:password@localhost:3306/ai_erp_system
# For Docker: mysql://erp_user:erp_password@db:3306/ai_erp_system
DATABASE_URL=mysql://user:password@localhost:3306/ai_erp_system

# Authentication
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=your-secret-key-here-min-32-chars-change-this
OWNER_OPEN_ID=

# ============================================
# LLM / AI Configuration (Anthropic Claude)
# ============================================
# Get your API key at: https://console.anthropic.com/settings/keys
# The system uses Claude for AI Assistant, AI Command Bar,
# autonomous workflows, document parsing, email categorization,
# and forecasting features.
#
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=claude-sonnet-4-20250514

# Google OAuth & API (for Google Sheets/Drive integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_SHEETS_API_KEY=

# Email Configuration (IMAP - for inbox scanning)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# SendGrid Email Service (for transactional emails)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_REPLY_TO=
SENDGRID_WEBHOOK_SECRET=

# QuickBooks OAuth & API
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=
QUICKBOOKS_ENVIRONMENT=sandbox

# EDI Webhook Authentication
# Required in production. Generate with: openssl rand -hex 32
EDI_WEBHOOK_SECRET=

# Shopify OAuth & API
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=

# OAuth Server (for federated/SSO authentication)
OAUTH_SERVER_URL=

# Twilio (voice/SMS integration)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Airtable Integration
AIRTABLE_PERSONAL_ACCESS_TOKEN=

# Forge API (image generation / data API)
FORGE_API_URL=
FORGE_API_KEY=

# OpenAI-compatible API (fallback LLM provider)
OPENAI_API_BASE_URL=
OPENAI_API_KEY=

# Alibaba Open Platform API (for live supplier search)
# Requires approved Alibaba developer app + OAuth token
ALIBABA_API_KEY=
ALIBABA_API_SECRET=
ALIBABA_API_ACCESS_TOKEN=
# Optional: override if Alibaba provides a different search endpoint for your app
ALIBABA_API_SEARCH_URL=
# Optional page size for supplier search (1-50, default 10)
ALIBABA_API_PAGE_SIZE=10

# AWS S3 (for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Error Tracking (optional — install @sentry/node to enable)
SENTRY_DSN=
